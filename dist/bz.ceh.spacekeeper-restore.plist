<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional: restore window-to-space assignments at login.

  Restores the newest settled previous-boot snapshot (the layout as of the
  last shutdown), then converges: as each app finishes launching its windows
  are matched and moved, so slow logins don't lose windows to a fixed settle
  delay. Stops when everything is placed, after 2 quiet minutes (no launches,
  no new matches), or at the 10m hard cap — the cap is a backstop, not a
  tuning knob. Frame restore is intentionally omitted here because AX can
  only resize windows on the active space.

  Install/remove via `make restore-agent-install` / `make restore-agent-uninstall`.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>bz.ceh.spacekeeper-restore</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec "$HOME/bin/spacekeeper" restore -converge 10m</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/spacekeeper-restore.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/spacekeeper-restore.log</string>
</dict>
</plist>
